# =============================================================================
# TrafficSense — Environment Variables
# Phase 0 | Copy this file to `.env` and fill in your values.
# NEVER commit `.env` to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API Server (Track B)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# For cross-laptop integration testing (replace with your ngrok URL):
# API_BASE_URL=https://abc123.ngrok.io

# -----------------------------------------------------------------------------
# Database (SQLite — relative to backend root)
# -----------------------------------------------------------------------------
DB_PATH=./data/trafficsense.db

# Seed data paths (read-only at startup)
SEED_SEGMENTS_PATH=./seed/segments.json
SEED_FLOOD_ZONES_PATH=./seed/flood_zones.json

# -----------------------------------------------------------------------------
# Open-Meteo (Free weather API — no key needed)
# Docs: https://open-meteo.com/en/docs
# -----------------------------------------------------------------------------
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# Comma-separated lat/lon pairs matching segment coordinates (same order as segments.json)
# Format: lat1,lon1;lat2,lon2;...
OPEN_METEO_COORDS=13.0632,80.2707;13.0604,80.2560;13.0837,80.2367;13.0067,80.2574;12.9810,80.2192;12.9516,80.1437
# Polling interval in seconds (do not set below 60 — API rate limit)
WEATHER_POLL_INTERVAL_SEC=60
# Offline fallback if Open-Meteo is unreachable
WEATHER_FALLBACK_FILE=./fallback/rain_cache.json

# -----------------------------------------------------------------------------
# OSRM (Routing — Track C)
# Run locally: docker run -p 5000:5000 -v $(pwd)/osrm-data:/data osrm/osrm-backend
# Or use the public demo server (rate-limited, do not use in production):
# OSRM_URL=https://router.project-osrm.org
# -----------------------------------------------------------------------------
OSRM_URL=http://localhost:5000
# Fallback static routes if OSRM is unavailable
OSRM_FALLBACK_FILE=./fallback/static_routes.json

# -----------------------------------------------------------------------------
# WebSocket (Real-Time Push — Track B → Track C & D)
# -----------------------------------------------------------------------------
WS_URL=ws://localhost:8000/ws/state
# Polling interval (ms) used by UIs when WebSocket is unavailable
WS_POLL_FALLBACK_MS=5000

# -----------------------------------------------------------------------------
# CCTV / YOLOv8n Runner (Track A)
# Install: pip install ultralytics opencv-python
# Run:     python cctv_runner.py --video $VIDEO_PATH --segment SEG_001
# -----------------------------------------------------------------------------
YOLO_MODEL=yolov8n.pt
# Path to sample traffic video for demo (download from spec doc dataset links)
VIDEO_PATH=./sample_videos/sample_traffic.mp4
# How many video frames to skip between YOLOv8 inferences (higher = faster, less accurate)
CCTV_FRAME_SKIP=5
# Sliding window size in video-seconds for anomaly calculation
CCTV_WINDOW_SEC=10
# Pixel displacement threshold below which a vehicle is classified as "stopped"
CCTV_STOP_PIXEL_THRESHOLD=5

# -----------------------------------------------------------------------------
# Decision Engine Thresholds (match escalation_thresholds in schemas.json)
# Change here to tune sensitivity without touching Python code.
# -----------------------------------------------------------------------------
YELLOW_MIN_CONFIDENCE=0.25
RED_MIN_CONFIDENCE=0.60
STOPPED_VEHICLE_TRIGGER_SEC=30
SLOW_VEHICLE_MIN_COUNT=2
SPEED_DROP_RATIO_THRESHOLD=0.55
CCTV_ANOMALY_YELLOW_THRESHOLD=0.35
CCTV_ANOMALY_RED_THRESHOLD=0.50
COMPLAINT_CLUSTER_WINDOW_SEC=120
COMPLAINT_CLUSTER_MIN_COUNT=1
SIGNALS_WINDOW_SEC=60

# -----------------------------------------------------------------------------
# Demo / Simulator
# -----------------------------------------------------------------------------
DEMO_DEFAULT_SEGMENT=SEG_001
# Auto-expire simulated RED/YELLOW states after N seconds (0 = never auto-expire)
DEMO_AUTO_EXPIRE_SEC=300

# -----------------------------------------------------------------------------
# CORS (allow all during development — restrict before any production deploy)
# -----------------------------------------------------------------------------
CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
